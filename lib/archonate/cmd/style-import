#!/usr/bin/env bash
. "$ARCHONATE_DIR/common.sh"
# archonate:summary=Download the latest themes and add the dark ones as styles
# archonate:args=[--force]
url=https://github.com/omacom/omarchy # the theme collection (credited in WALLPAPERS.md)
src="$HOME/.cache/archonate/style-source"
if [ -d "$src/.git" ]; then git -C "$src" fetch -q --depth 1 origin && git -C "$src" reset -q --hard FETCH_HEAD || true
else mkdir -p "${src%/*}" && git clone -q --depth 1 "$url" "$src"; fi
[ -d "$src/themes" ] || { echo "couldn't download the themes (no network?); try again later" >&2; exit 1; }
python3 -I "$ARCHONATE_DIR/import-styles.py" "$src" --skip-logo="${url##*/}" "$@"
