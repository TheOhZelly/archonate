#!/usr/bin/env bash
. "$ARCHONATE_DIR/common.sh"
# archonate:summary=Make a launcher for a terminal app (btop, lazygit, ncspot...) so it opens like any app
# archonate:args=[name] [command]
. "$ARCHONATE_DIR/webapp.sh"
set -uo pipefail
name=${1:-} cmd=${2:-}
[ -n "$name" ] || name=$(ask "TUI name") || exit 0
[ -n "$name" ] || exit 0
[ -n "$cmd" ] || cmd=$(ask "Command to run") || exit 0
[ -n "$cmd" ] || exit 0
command -v "${cmd%% *}" >/dev/null || notify "Heads up" "'${cmd%% *}' isn't installed yet; the launcher will work once it is"
slug=$(slugify "$name")
[ -n "$slug" ] || { notify "TUI" "Give it a name with letters or numbers in it"; exit 1; }
mkdir -p "$APPS"
# its own icon if the program ships one, else a terminal
icon=utilities-terminal
for i in /usr/share/icons/hicolor/scalable/apps/"${cmd%% *}".svg /usr/share/icons/hicolor/256x256/apps/"${cmd%% *}".png /usr/share/pixmaps/"${cmd%% *}".png; do
    [ -f "$i" ] && { icon=$i; break; }
done
cat >"$APPS/archonate-tui-$slug.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=$name
Comment=$cmd, in a terminal
Exec=$HOME/.local/bin/archonate tui open $(exec_quote "$cmd")
Icon=$icon
Categories=ConsoleOnly;System;
Terminal=false
X-Archonate=tui
DESK
refresh_launcher
notify "TUI ready" "$name is in the launcher"
echo "$name -> $cmd"
