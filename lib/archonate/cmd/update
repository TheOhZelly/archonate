#!/usr/bin/env bash
. "$ARCHONATE_DIR/common.sh"
# archonate:summary=Update Archonate and the whole system (cachy-update way), with a snapshot first and a health check after
# archonate:args=[--devel]
# cachy-update (CachyOS's arch-update) does the update itself: the pending list
# and a confirmation, the latest news, repos then AUR (paru or yay), and afterwards
# orphans, the package cache, .pacnew/.pacsave files, a pending kernel reboot
# and services needing a restart. Archonate wraps it: a labelled snapshot
# before, your post-update hooks, archonate doctor and the bar's update badge after.
# --devel also updates AUR -git packages (cachy-update --devel).

# From the bar, menu or Settings there is no terminal for sudo, so open one
if [ ! -t 0 ]; then
    exec kitty --class archonate-term --title "Archonate update" -o confirm_os_window_close=0 "$BIN/archonate" update "$@"
fi

"$BIN/archonate" logo; echo
sudo true || exit 1 # the password once, up front (the snapshot needs it too)
"$BIN/archonate" snapshot create "before archonate update" || echo -e "\e[33mNo snapshot taken; carrying on.\e[0m"
echo

# ---- Archonate itself: the latest from its git repo (fast-forward only) --------
arch_old=$(git -C "$HYPR_DIR" rev-parse HEAD 2>/dev/null || true)
if [ -n "$arch_old" ] && git -C "$HYPR_DIR" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    echo -e "\e[1mUpdating Archonate…\e[0m"
    if git -C "$HYPR_DIR" pull -q --ff-only; then
        arch_new=$(git -C "$HYPR_DIR" rev-parse HEAD)
        if [ "$arch_new" = "$arch_old" ]; then echo "  already the latest"
        else git -C "$HYPR_DIR" log --format='  %s' "$arch_old..$arch_new" | head -15; fi
    else
        echo -e "  \e[33mcouldn't fast-forward (local commits or edits in the way); kept as is\e[0m"
    fi
    echo
fi

before=$(pacman -Q | md5sum)
if command -v cachy-update >/dev/null; then
    cachy-update ${1:+"$1"}
    status=$?
else
    # not CachyOS (or cachy-update removed): the AUR helper, or plain pacman
    if [ -n "$AUR_HELPER" ]; then
        "$AUR_HELPER" -Syu
    else
        sudo pacman -Syu
    fi
    status=$?
fi
after=$(pacman -Q | md5sum)

echo
if [ "$before" != "$after" ]; then
    python3 "$ARCHONATE_PY" hook post-update || true
    echo -e "\e[1mChecking Archonate after the update…\e[0m"
    "$BIN/archonate" doctor --quiet --notify || true
    if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
        notify -u normal "Updated" "Restart to finish: the kernel was replaced."
    else
        notify "Updated" "Everything is up to date."
    fi
elif [ $status -ne 0 ]; then
    echo -e "\e[33mNothing was installed (exit $status).\e[0m"
fi
# A new Archonate whose setup changed (new packages, new defaults): run it again
if [ -n "${arch_new:-}" ] && [ "$arch_new" != "$arch_old" ] &&
    ! git -C "$HYPR_DIR" diff --quiet "$arch_old" "$arch_new" -- install.sh; then
    echo -e "\n\e[1mArchonate's setup changed: running it again (install.sh --yes)…\e[0m"
    "$HYPR_DIR/install.sh" --yes || echo -e "\e[33minstall.sh stopped; run it yourself: ~/.config/hypr/install.sh\e[0m"
    touch "$HYPR_DIR/rices/$(current_rice)/shell/shell.qml" 2>/dev/null || true # the shell picks up new code
elif [ -n "${arch_new:-}" ] && [ "$arch_new" != "$arch_old" ]; then
    touch "$HYPR_DIR/rices/$(current_rice)/shell/shell.qml" 2>/dev/null || true
fi
shell_ipc checkUpdates >/dev/null 2>&1 || true # refresh the bar's badge
# Keep your coding agents' Archonate skills current (unless you turned them off)
[ -f "$HOME/.config/archonate/agent-skills-off" ] || "$BIN/archonate" agent skills on >/dev/null 2>&1 || true
"$BIN/archonate" apps install >/dev/null 2>&1 || true # launcher entries match this version
echo; read -rsn1 -p "Done. Press any key to close."
